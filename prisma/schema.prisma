// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  STAFF
}

enum InventoryStatus {
  ACTIVE
  CLOSED
}

enum NotificationType {
  CLOSING_SUMMARY
  LOW_STOCK_ALERT
  SYSTEM_INFO
}

enum ClosingStatus {
  DRAFT
  REVIEWED
  CLOSED
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  role      Role     @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions  Transaction[]
  closings      MonthlyClosing[]
  notifications Notification[]
  bankAccounts  BankAccount[]
  bills         Bill[]

  @@map("profiles")
}

model Product {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageLink    String   @map("image_link") @default("")
  name         String   @unique
  defaultCost  Decimal  @map("default_cost") @db.Decimal(12, 2)
  defaultPrice Decimal  @map("default_price") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  inventories  MonthlyInventory[]
  transactions Transaction[]

  @@map("products")
}

model MonthlyInventory {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String          @map("product_id") @db.Uuid
  period       String          // Format: "YYYY-MM"
  initialStock Int             @map("initial_stock")
  addedStock   Int             @default(0) @map("added_stock")
  currentStock Int             @map("current_stock")
  status       InventoryStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, period])
  @@map("monthly_inventories")
}

model Transaction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  createdById  String   @map("created_by_id") @db.Uuid
  accountId    String?  @map("account_id") @db.Uuid
  period       String   // Format: "YYYY-MM"
  quantity     Int
  costPrice    Decimal  @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  totalProfit  Decimal  @map("total_profit") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  product   Product      @relation(fields: [productId], references: [id])
  createdBy Profile      @relation(fields: [createdById], references: [id])
  account   BankAccount? @relation(fields: [accountId], references: [id])

  @@map("transactions")
}

model MonthlyClosing {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period       String   @unique // Format: "YYYY-MM"
  totalRevenue Decimal  @map("total_revenue") @db.Decimal(12, 2)
  totalCapital Decimal  @map("total_capital") @db.Decimal(12, 2)
  netProfit    Decimal  @map("net_profit") @db.Decimal(12, 2)
  status       ClosingStatus @default(DRAFT)
  itemsSnapshot  Json   @default("[]") @map("items_snapshot")
  closedById   String?  @map("closed_by_id") @db.Uuid
  closedAt     DateTime @default(now()) @map("closed_at")

  closedBy Profile? @relation(fields: [closedById], references: [id])

  @@map("monthly_closings")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  message   String
  type      NotificationType @default(SYSTEM_INFO)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum AccountType {
  BANK
  EWALLET
  CASH
}

enum MutationType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

model BankAccount {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  bankName      String          @map("bank_name")
  accountNumber String          @map("account_number")
  holderName    String          @map("holder_name")
  type          AccountType     @default(BANK)
  balance       Decimal         @default(0) @db.Decimal(14, 2)
  isActive      Boolean         @default(true) @map("is_active")
  isPrimary     Boolean         @default(false) @map("is_primary")
  notes         String?
  createdById   String?         @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  createdBy     Profile?        @relation(fields: [createdById], references: [id])
  mutations     AccountMutation[]
  transactions  Transaction[]
  billPayments  BillPayment[]

  @@map("bank_accounts")
}

model AccountMutation {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String       @map("account_id") @db.Uuid
  type        MutationType
  amount      Decimal      @db.Decimal(14, 2)
  description String
  reference   String?
  createdAt   DateTime     @default(now()) @map("created_at")

  account     BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_mutations")
}

enum BillType {
  RECEIVABLE  // Piutang (Pelanggan berutang ke kita)
  PAYABLE     // Utang (Kita berutang ke supplier/operasional)
}

enum BillStatus {
  UNPAID      // Belum Dibayar
  PARTIAL     // Dibayar Sebagian
  PAID        // Lunas
  OVERDUE     // Jatuh Tempo
}

model Bill {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber String       @unique @map("invoice_number")
  title         String
  contactName   String       @map("contact_name")
  contactPhone  String?      @map("contact_phone")
  type          BillType     @default(RECEIVABLE)
  status        BillStatus   @default(UNPAID)
  totalAmount   Decimal      @map("total_amount") @db.Decimal(14, 2)
  paidAmount    Decimal      @default(0) @map("paid_amount") @db.Decimal(14, 2)
  dueDate       DateTime     @map("due_date")
  itemsJson     Json         @default("[]") @map("items_json")
  notes         String?
  createdById   String?      @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  createdBy     Profile?     @relation(fields: [createdById], references: [id])
  payments      BillPayment[]

  @@map("bills")
}

model BillPayment {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId      String       @map("bill_id") @db.Uuid
  accountId   String?      @map("account_id") @db.Uuid
  amount      Decimal      @db.Decimal(14, 2)
  paymentDate DateTime     @default(now()) @map("payment_date")
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")

  bill        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  account     BankAccount? @relation(fields: [accountId], references: [id])

  @@map("bill_payments")
}